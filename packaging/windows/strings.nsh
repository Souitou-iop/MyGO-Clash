; The installer's own texts, in each language it offers. The standard texts
; of the pages come from NSIS's language files.
;
; Each string is defined twice, as $(Name) for the installer and $(un.Name)
; for the uninstaller. $OldVer is the installed version, and the defines
; PRODUCT_NAME, VERSION and SERVICE_NAME come from the build.
;
; Keep the ids of installer.nsi in step: ReinstTitle, ReinstSubtitle,
; ReinstSame, ReinstOlder, ReinstUnknown, ReinstNewer, OptRepair,
; OptUninstall, OptUpgrade, OptDowngrade, OptClean, RunningMsg, CloseFailed,
; UninstallFailed, DesktopShortcut, DeleteData, ServiceAsk, ServiceLeft.

!macro LS lang id text
  LangString ${id} ${LANG_${lang}} "${text}"
  LangString un.${id} ${LANG_${lang}} "${text}"
!macroend

; ---- English ----
!insertmacro LS ENGLISH ReinstTitle "Already installed"
!insertmacro LS ENGLISH ReinstSubtitle "Choose how to proceed."
!insertmacro LS ENGLISH ReinstSame "${PRODUCT_NAME} $OldVer is already installed.$\r$\n$\r$\nWhat would you like to do?"
!insertmacro LS ENGLISH ReinstOlder "${PRODUCT_NAME} $OldVer is installed. Version ${VERSION} will update it.$\r$\n$\r$\nHow would you like to install?"
!insertmacro LS ENGLISH ReinstUnknown "An existing installation of ${PRODUCT_NAME} was found.$\r$\n$\r$\nHow would you like to install version ${VERSION}?"
!insertmacro LS ENGLISH ReinstNewer "A newer version of ${PRODUCT_NAME} ($OldVer) is installed. Installing version ${VERSION} is a downgrade, and settings saved by the newer version may not work with it.$\r$\n$\r$\nHow would you like to proceed?"
!insertmacro LS ENGLISH OptRepair "Repair / reinstall ${PRODUCT_NAME} (keeps your settings)"
!insertmacro LS ENGLISH OptUninstall "Uninstall ${PRODUCT_NAME}"
!insertmacro LS ENGLISH OptUpgrade "Upgrade to version ${VERSION} (recommended, keeps your settings)"
!insertmacro LS ENGLISH OptDowngrade "Downgrade to version ${VERSION} (keeps your settings)"
!insertmacro LS ENGLISH OptClean "Remove the old program files first, then install (keeps your settings)"
!insertmacro LS ENGLISH RunningMsg "${PRODUCT_NAME} is running. It must be closed, together with its core, to continue.$\r$\n$\r$\nClick OK to close it now, or Cancel to quit."
!insertmacro LS ENGLISH CloseFailed "${PRODUCT_NAME} could not be closed. Quit it from its tray icon, then click Retry."
!insertmacro LS ENGLISH UninstallFailed "The uninstaller of the existing installation could not be run."
!insertmacro LS ENGLISH DesktopShortcut "Create a desktop shortcut"
!insertmacro LS ENGLISH DeleteData "Also delete app data (settings, profiles, logs and cache)"
!insertmacro LS ENGLISH ServiceAsk "The ${PRODUCT_NAME} service (used by TUN mode) is installed. Removing it needs administrator permission.$\r$\n$\r$\nRemove it now?"
!insertmacro LS ENGLISH ServiceLeft "The service was not removed. To remove it later, run this in an administrator command prompt:$\r$\n$\r$\nsc delete ${SERVICE_NAME}"

